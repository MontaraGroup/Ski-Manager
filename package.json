{
  "name": "v2",
  "version": "1.0.0",
  "description": "## What is CodeIgniter?",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:antislop && npm run test:budget",
    "test:antislop": "python3 scripts/check_antislop.py",
    "test:budget": "python3 scripts/check_bundle_budget.py",
    "test:e2e": "playwright test",
    "build": "npm run build:css && npm run build:islands",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./public/css/input.css -o ./public/css/style.css --minify",
    "build:islands": "node ./node_modules/typescript/lib/tsc.js && node ./node_modules/vite/bin/vite.js build",
    "dev": "vite",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  }
}
